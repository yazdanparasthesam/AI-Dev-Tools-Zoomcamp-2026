--- a/database.py
+++ b/database.py
@@ -189,7 +189,11 @@ def immediate_transaction() -> Generator[Session, None, None]:
     connection = engine.connect()
     session = Session(bind=connection, expire_on_commit=False, autoflush=True)
     try:
-        connection.exec_driver_sql("BEGIN IMMEDIATE")
+        if _is_sqlite(DATABASE_URL):
+            connection.exec_driver_sql("BEGIN IMMEDIATE")
+        # PostgreSQL: SQLAlchemy's autobegin already opened a transaction.
+        # Writer serialization comes from row locks (claim_one uses
+        # FOR UPDATE SKIP LOCKED) instead of SQLite-only BEGIN IMMEDIATE.
         yield session
         session.flush()
         connection.commit()
