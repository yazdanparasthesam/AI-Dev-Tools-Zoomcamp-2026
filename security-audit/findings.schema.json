{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityFinding",
  "type": "object",
  "required": ["id", "title", "severity", "status", "disposition"],
  "properties": {
    "id": { "type": "string", "pattern": "^F-[0-9]{2}$" },
    "title": { "type": "string" },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "status": { "enum": ["open", "mitigated", "fixed", "accepted"] },
    "disposition": { "type": "string" },
    "detected_by": { "type": "string" },
    "incident_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}
